# Copy this file to functions/.env (never commit the real .env) or set each
# value with `firebase functions:secrets:set NAME`, then redeploy functions.
# Nothing in mobile-money billing works until these are filled in - see the
# comment above `initiateMobileMoneyCharge` in functions/index.js.

# --- MTN MoMo Collections API ---
# From https://momodeveloper.mtn.com - create a Collections product
# subscription to get the subscription key, then provision an API user/key
# against it.
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
# Set after first deploy: https://REGION-PROJECT.cloudfunctions.net/mtnMomoWebhook?secret=WEBHOOK_SHARED_SECRET
MTN_MOMO_CALLBACK_URL=

# --- Airtel Money Collection API ---
# From https://developers.airtel.africa - register an app to get these.
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
# Register on the Airtel developer portal after first deploy:
# https://REGION-PROJECT.cloudfunctions.net/airtelMoneyWebhook?secret=WEBHOOK_SHARED_SECRET

# --- Shared ---
# Any long random string - protects the two webhook endpoints above, since
# neither provider signs its callback payloads by default.
WEBHOOK_SHARED_SECRET=

# --- Google Sheets attendance export ---
# 1. In Google Cloud Console (same project as Firebase, or another one),
#    create a service account and enable the Google Sheets API for it.
# 2. Create a JSON key for that service account and paste its full contents
#    here as a single line (or `firebase functions:secrets:set
#    GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON < key.json`).
# 3. Each school shares their target spreadsheet with the service account's
#    "client_email" (Editor access) - the same way you'd share a sheet with
#    any collaborator - then pastes the spreadsheet id (from its URL) into
#    the Sheets Integration screen.
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
