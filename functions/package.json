{
  "name": "functions",
  "description": "Cloud Functions for School Pulse",
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "scripts": {
    "test:rules": "firebase emulators:exec --only firestore --project demo-school-pulse-rules-test \"node --test test/firestore.rules.test.cjs\"",
    "test:report-card-engine": "node report_card_engine.test.js",
    "test:report-card-engine:emulator": "firebase emulators:exec --only firestore --project demo-report-card-engine-test \"node --test test/report_card_engine.emulator.test.cjs\"",
    "test:report-card-workflow:emulator": "firebase emulators:exec --only firestore --project demo-report-card-workflow-test \"node --test test/report_card_approval_workflow.emulator.test.cjs\"",
    "test:report-card-bursar:emulator": "firebase emulators:exec --only firestore --project demo-report-card-bursar-test \"node --test test/report_card_bursar_release.emulator.test.cjs\"",
    "test:report-card-release-exceptions:emulator": "firebase emulators:exec --only firestore --project demo-report-card-release-exceptions-test \"node --test test/report_card_release_exceptions.emulator.test.cjs\"",
    "test:student-fee-billing:emulator": "firebase emulators:exec --only firestore --project demo-student-fee-billing-test \"node --test test/student_fee_billing.emulator.test.cjs\"",
    "test:payment-codes:emulator": "firebase emulators:exec --only firestore --project demo-payment-codes-test \"node --test test/payment_codes.emulator.test.cjs\"",
    "test:finance-governance:emulator": "firebase emulators:exec --only firestore --project demo-finance-governance-test \"node --test test/finance_governance.emulator.test.cjs\"",
    "test:finance-operations:emulator": "firebase emulators:exec --only firestore --project demo-finance-operations-test \"node --test test/finance_operations.emulator.test.cjs\"",
    "test:create-staff-account:emulator": "firebase emulators:exec --only firestore,auth --project demo-create-staff-account-test \"node --test test/create_staff_account.emulator.test.cjs\"",
    "test:storage-rules": "firebase emulators:exec --only firestore,storage --project demo-school-pulse-storage-rules-test \"node --test test/storage.rules.test.cjs\"",
    "logs": "firebase functions:log",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^5.1.1",
    "googleapis": "^144.0.0",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase": "^12.16.0"
  },
  "private": true
}
