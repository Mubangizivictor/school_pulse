# MTN Mobile Money Collections integration (public_functions/mtn_momo.js).
#
# The three credential values (MTN_MOMO_API_USER, MTN_MOMO_API_KEY,
# MTN_MOMO_SUBSCRIPTION_KEY) are NOT set here - they are real secrets and
# must only ever be set via Secret Manager:
#
#   firebase functions:secrets:set MTN_MOMO_API_USER --project school-pulse-3d95b
#   firebase functions:secrets:set MTN_MOMO_API_KEY --project school-pulse-3d95b
#   firebase functions:secrets:set MTN_MOMO_SUBSCRIPTION_KEY --project school-pulse-3d95b
#
# The values below are plain, non-sensitive configuration (base URL,
# environment name, sandbox test MSISDN/amount are public per MTN's own
# sandbox docs). Copy this file to public_functions/.env.publicwebsite (or
# .env.publicwebsite.<projectId> for a project-specific override) to change
# them from the defaults baked into mtn_config.js - do not commit the real
# .env file.

# sandbox | mtnuganda (production Uganda, once commercial onboarding + real
# credentials are issued - see mtn_config.js's getMtnConfig()).
MTN_MOMO_TARGET_ENVIRONMENT=sandbox

# Sandbox default: https://sandbox.momodeveloper.mtn.com
# Production Uganda endpoint must be supplied here once known - never guessed.
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com

# Sandbox only - MTN's fixed test MSISDN that resolves to SUCCESSFUL. Real
# user phone numbers are never sent to MTN while in sandbox mode.
MTN_MOMO_SANDBOX_TEST_MSISDN=256700000000

# Sandbox only - MTN sandbox requires currency=EUR and accepts small test
# amounts; this is never the real UGX subscription price shown to the user.
MTN_MOMO_SANDBOX_TEST_AMOUNT=100
