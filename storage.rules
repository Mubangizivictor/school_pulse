rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSameSchool(schoolId) {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.schoolId == schoolId;
    }
    function isActiveInstitutionMember(institutionId) {
      return request.auth != null && (
        isSameSchool(institutionId) ||
        (firestore.exists(/databases/(default)/documents/institution_memberships/$(request.auth.uid + '_' + institutionId)) &&
         firestore.get(/databases/(default)/documents/institution_memberships/$(request.auth.uid + '_' + institutionId)).data.status == 'active')
      );
    }
    function canManageInstitutionBranding(schoolId) {
      return request.auth != null && isSameSchool(schoolId) &&
        (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
          in ['schoolAdmin', 'headTeacher', 'deputyHead', 'director'] ||
         ('roles' in firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data &&
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.roles.hasAny(
            ['schoolAdmin', 'headTeacher', 'deputyHead', 'director'])));
    }

    match /school_assets/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /schools/{schoolId}/school_assets/{fileName} {
      allow read: if isSameSchool(schoolId);
      allow write: if isSameSchool(schoolId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isSameSchool(schoolId);
    }
    match /institutions/{institutionId}/branding/{assetType}/{fileName} {
      allow read: if isSameSchool(institutionId);
      allow write: if canManageInstitutionBranding(institutionId)
        && assetType in ['logo', 'badge', 'splash', 'banners']
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpe?g|webp)');
      allow delete: if canManageInstitutionBranding(institutionId);
    }
    match /profile_photos/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    function isConversationParticipant(conversationId) {
      return request.auth != null &&
        request.auth.uid in firestore.get(
          /databases/(default)/documents/conversations/$(conversationId)
        ).data.participantIds;
    }
    match /chat_attachments/{schoolId}/{conversationId}/{fileName} {
      allow read: if isSameSchool(schoolId) && isConversationParticipant(conversationId);
      allow write: if isSameSchool(schoolId) && isConversationParticipant(conversationId)
        && request.resource.size < 15 * 1024 * 1024;
    }
    match /class_resources/{schoolId}/{classId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 200 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('audio/.*')
          || request.resource.contentType.matches('video/.*')
          || request.resource.contentType.matches('text/plain')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.*')
          || request.resource.contentType.matches('application/vnd.oasis.opendocument.*')
          || request.resource.contentType == 'application/msword'
          || request.resource.contentType == 'application/vnd.ms-excel'
          || request.resource.contentType == 'application/vnd.ms-powerpoint'
          || request.resource.contentType == 'text/csv'
        );
      allow delete: if request.auth != null;
    }

    match /schools/students/{studentId}/documents/{fileName} {
      allow read: if isSameSchool(
        firestore.get(/databases/(default)/documents/students/$(studentId)).data.schoolId
      );
      allow write: if isSameSchool(
        firestore.get(/databases/(default)/documents/students/$(studentId)).data.schoolId
      )
        && request.resource.size < 25 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.*')
          || request.resource.contentType.matches('application/vnd.oasis.opendocument.*')
          || request.resource.contentType == 'application/msword'
        );
      allow delete: if isSameSchool(
        firestore.get(/databases/(default)/documents/students/$(studentId)).data.schoolId
      );
    }

    match /payment_proofs/{uid}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
        );
      allow update, delete: if false;
    }

    // Official report-card PDFs. No client - staff, parent or student -
    // ever reads this path directly: every download is mediated by
    // getReportCardPdfDownloadUrl (a Cloud Function using the Admin SDK,
    // not subject to these rules), which re-checks academic/financial
    // access and hands back a short-lived signed URL instead. Writes only
    // ever happen from generateReportCardPdf, also Admin SDK. Explicit
    // deny-all here rather than relying on the catch-all at the bottom, so
    // a future change to that catch-all can never accidentally expose it.
    match /schools/{schoolId}/reportCards/{reportCardId}/{fileName} {
      allow read, write: if false;
    }

    match /institutions/{institutionId}/integrations/{allPaths=**} {
      allow read, write: if false;
    }

    match /institutions/{institutionId}/data_operations/imports/{fileName} {
      allow create: if isActiveInstitutionMember(institutionId)
        && request.resource.size < 25 * 1024 * 1024
        && (request.resource.contentType == 'text/csv'
          || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');
      allow read, update, delete: if false;
    }
    match /institutions/{institutionId}/data_operations/{kind}/{fileName} {
      allow read, write: if false;
    }

    match /institutions/{institutionId}/support/{requestId}/{fileName} {
      allow read: if false;
      allow create: if isActiveInstitutionMember(institutionId)
        && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/(png|jpeg|webp)')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType == 'text/csv');
      allow update, delete: if false;
    }

    match /schools/{schoolId}/calendar_events/{eventId}/attachments/{fileName} {
      allow read: if isSameSchool(schoolId);
      allow write: if isSameSchool(schoolId)
        && request.resource.size < 10 * 1024 * 1024;
      allow delete: if isSameSchool(schoolId);
    }

    match /schools/{schoolId}/communication_campaigns/{campaignId}/{fileName} {
      allow read: if isSameSchool(schoolId);
      allow write: if isSameSchool(schoolId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
      allow delete: if isSameSchool(schoolId);
    }
    match /schools/{schoolId}/communication_campaigns/{campaignId}/attachments/{fileName} {
      allow read: if isSameSchool(schoolId);
      allow write: if isSameSchool(schoolId)
        && request.resource.size < 15 * 1024 * 1024;
      allow delete: if isSameSchool(schoolId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
