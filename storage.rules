rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSameSchool(schoolId) {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.schoolId == schoolId;
    }
    function canManageInstitutionBranding(schoolId) {
      return request.auth != null && isSameSchool(schoolId) &&
        (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
          in ['schoolAdmin', 'headTeacher', 'deputyHead', 'director'] ||
         ('roles' in firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data &&
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.roles.hasAny(
            ['schoolAdmin', 'headTeacher', 'deputyHead', 'director'])));
    }

    match /school_assets/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Canonical school branding/configuration assets. The legacy
    // /school_assets root is retained only for existing URLs; all current
    // admin uploads use this scoped path.
    match /schools/{schoolId}/school_assets/{fileName} {
      allow read: if isSameSchool(schoolId);
      allow write: if isSameSchool(schoolId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isSameSchool(schoolId);
    }
    // Institution Settings uploads use a deliberately narrow, tenant-scoped
    // namespace.  This prevents one tenant's branding from being addressed
    // through another tenant's conventional school-assets folder.
    match /institutions/{institutionId}/branding/{assetType}/{fileName} {
      allow read: if isSameSchool(institutionId);
      allow write: if canManageInstitutionBranding(institutionId)
        && assetType in ['logo', 'badge', 'splash', 'banners']
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
      allow delete: if canManageInstitutionBranding(institutionId);
    }
    match /profile_photos/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // Photos and group avatars shared through the /messages module. Storage
    // rules can't read Firestore, so membership can't be checked here - the
    // gate is that the download URL only ever reaches participants (it is
    // stored on a message document, which IS membership-protected in
    // firestore.rules).
    match /chat_attachments/{schoolId}/{conversationId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 15 * 1024 * 1024;
    }
    // Class Teacher resource area. Storage rules cannot read Firestore, so
    // "is this your class" is enforced in firestore.rules on the
    // class_resources document that carries the path - a blob with no
    // document pointing at it is unreachable from the app.
    //
    // What this layer can enforce is size and type, and it does: the content
    // type must be one of the kinds a class folder accepts, so an executable
    // is refused here as well as at the client guard.
    match /class_resources/{schoolId}/{classId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 200 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('audio/.*')
          || request.resource.contentType.matches('video/.*')
          || request.resource.contentType.matches('text/plain')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.*')
          || request.resource.contentType.matches('application/vnd.oasis.opendocument.*')
          || request.resource.contentType == 'application/msword'
          || request.resource.contentType == 'application/vnd.ms-excel'
          || request.resource.contentType == 'application/vnd.ms-powerpoint'
          || request.resource.contentType == 'text/csv'
        );
      allow delete: if request.auth != null;
    }

    // Student admission/profile documents (birth certificates, prior
    // reports, IDs). Cross-references the student's own schoolId via
    // isSameSchool (same firestore.get() pattern used by
    // /schools/{schoolId}/school_assets above) so a staff member from
    // another tenant who obtains or guesses a studentId/fileName can't
    // read, overwrite, or delete another school's student documents -
    // previously any authenticated user passed this rule outright.
    match /schools/students/{studentId}/documents/{fileName} {
      allow read: if isSameSchool(
        firestore.get(/databases/(default)/documents/students/$(studentId)).data.schoolId
      );
      allow write: if isSameSchool(
        firestore.get(/databases/(default)/documents/students/$(studentId)).data.schoolId
      )
        && request.resource.size < 25 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.*')
          || request.resource.contentType.matches('application/vnd.oasis.opendocument.*')
          || request.resource.contentType == 'application/msword'
        );
      allow delete: if isSameSchool(
        firestore.get(/databases/(default)/documents/students/$(studentId)).data.schoolId
      );
    }

    // Subscription payment proof is private to the submitting administrator.
    // The SaaS Owner gets temporary access only through an owner-authorized
    // Cloud Function; there is no public proof URL stored in Firestore.
    // Proof is create-only: after submission the client cannot replace or
    // delete the evidence before owner verification.
    match /payment_proofs/{uid}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
        );
      allow update, delete: if false;
    }

    // School Calendar event attachments. Tenant-scoped like school_assets;
    // size/type enforced here since Storage rules can't check
    // calendar.manage against Firestore role_permission_overrides - the
    // write path from the app already gates on that permission before
    // upload, this is a defense-in-depth backstop.
    match /schools/{schoolId}/calendar_events/{eventId}/attachments/{fileName} {
      allow read: if isSameSchool(schoolId);
      allow write: if isSameSchool(schoolId)
        && request.resource.size < 10 * 1024 * 1024;
      allow delete: if isSameSchool(schoolId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
