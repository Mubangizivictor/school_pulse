# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Cloud Functions
/functions/node_modules/
/functions/lib/
/public_functions/node_modules/
/web_marketing/node_modules/
firebase-debug.log
firebase-debug.*.log
.firebase/

# Secrets - never commit real .env files (see functions/.env.example)
.env
.env.*
!.env.example
!*.env.example

# Cleanup script manifests contain user emails/PII - never commit
/cleanup_backups/

# Local backups of Firebase config files - never commit
/.config_backups/

# Android release signing - the keystore and its credentials must never be
# committed. key.properties holds the store/key passwords and alias in
# plaintext; keep it local or inject via CI secrets, never in git.
/android/key.properties
*.jks
*.keystore

# Apple Sign-In / APNs private keys (.p8) and any service account JSON -
# never committed, regardless of where they end up on disk.
*.p8
*service-account*.json
*serviceAccountKey*.json

# Isar's native binary, copied to the project root so `flutter test` can
# dlopen() it on macOS (Isar looks in the working directory) - vendored from
# isar_flutter_libs' own macos/ build output, never checked in.
/libisar.dylib

# Old projects kept locally (not part of this repo)
/_old/
