      allow read, write: if isStaff();
    }
    match /inventory_items/{id} {
      allow read, write: if isStaff();
    }
    match /inventory_movements/{id} {
      allow read, write: if isStaff();
    }
    match /school_events/{id} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /subscription/{id} {
      allow read, write: if isStaff();
    }
    match /payment_transactions/{id} {
      allow read: if isStaff();
      allow write: if false;
    }
    match /lesson_plans/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isStaff() && resource.data.teacherId == request.auth.uid;
    }

    match /broadcast_queue/{id} {
      allow create: if isStaff();
      allow read, update, delete: if false;
    }
    match /sms_queue/{id} {
      allow create: if isStaff();
      allow read, update, delete: if false;
    }
    match /notification_queue/{id} {
      allow create: if isSignedIn();
      allow read, update, delete: if false;
    }

    match /schools/{schoolId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }
    match /tenants/{tenantId} {
      allow read, write: if isSuperAdmin();
    }
    match /subscription_plans/{id} {
      allow read, write: if isSuperAdmin();
    }
    match /school_admin_invitations/{id} {
      allow create: if isSuperAdmin();
      allow read, update, delete: if false;
    }
    match /super_admin_audit_logs/{id} {
      allow read, create: if isSuperAdmin();
      allow update, delete: if false;
    }
    match /invoices/{id} {
      allow read, write: if isSuperAdmin();
    }
    match /transactions/{id} {
      allow read, write: if isSuperAdmin();
    }
    match /platform_config/{id} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }
  }
}
