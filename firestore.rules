rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myRole() {
      return myUser().role;
    }

    function isParent() {
      return isSignedIn() && myRole() == 'parent';
    }

    function isStudent() {
      return isSignedIn() && myRole() == 'student';
    }

    function isStaff() {
      return isSignedIn() && myRole() != 'parent' && myRole() != 'student';
    }

    // The SaaS platform owner. Deliberately checked against myRole() only
    // (not hasAnyRole/roles[]) - superAdmin is never a secondary role on a
    // school-scoped staff account, it is seeded once via a server-side
    // script that never runs through client rules.
    function isSuperAdmin() {
      return isSignedIn() && myRole() == 'superAdmin';
    }

    function hasAnyRole(allowedRoles) {
      // Secondary roles are only meaningful for staff accounts. In
      // particular, never let a parent/student profile with a forged roles
      // array inherit staff privileges from this helper.
      return isStaff() && (
        myRole() in allowedRoles ||
        ('roles' in myUser() && myUser().roles.hasAny(allowedRoles))
      );
    }

    function canManageClinicalRecords() {
      return hasAnyRole([
        'nurse', 'schoolAdmin', 'headTeacher', 'deputyHead', 'director'
      ]);
    }

    function canManageMedicalSupplies() {
      return hasAnyRole([
        'nurse', 'storeInventory', 'bursar', 'schoolAdmin',
        'headTeacher', 'director'
      ]);
    }

    function isParentOf(studentId) {
      return isParent() && studentId in myUser().studentIds;
    }

    function isSameSchool(schoolId) {
      return isSignedIn() && myUser().schoolId == schoolId;
    }

    function isMe(studentId) {
      return isStudent() && myUser().studentId == studentId;
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isStaff());
      allow create: if isSignedIn() && request.auth.uid == uid && request.resource.data.role == 'parent';
      allow update: if isSignedIn() && (
        (request.auth.uid == uid && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword']) &&
           request.resource.data.mustChangePassword == false) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentIds']) &&
           resource.data.role == 'parent' &&
           request.resource.data.studentIds.size() > resource.data.studentIds.size())
        )) ||
        (isStaff() && resource.data.role != 'parent')
      );
      allow delete: if isStaff() && resource.data.role != 'parent';
    }

    match /school_contacts/{uid} {
      allow read: if isSameSchool(resource.data.schoolId);
      allow create: if hasAnyRole([
          'schoolAdmin', 'headTeacher', 'director'
        ]) && isSameSchool(request.resource.data.schoolId) &&
        request.resource.data.keys().hasOnly([
          'name', 'role', 'roles', 'schoolId', 'isActive'
        ]);
      allow update: if hasAnyRole([
          'schoolAdmin', 'headTeacher', 'director'
        ]) && isSameSchool(resource.data.schoolId) &&
        request.resource.data.schoolId == resource.data.schoolId &&
        request.resource.data.keys().hasOnly([
          'name', 'role', 'roles', 'schoolId', 'isActive'
        ]);
      allow delete: if hasAnyRole([
          'schoolAdmin', 'headTeacher', 'director'
        ]) && isSameSchool(resource.data.schoolId);
    }

    // --- Messaging ---------------------------------------------------------
    // Field names must stay in sync with:
    //   lib/features/messages/data/models/conversation_model.dart (toCreateJson)
    //   lib/features/messages/data/models/chat_message_model.dart (toCreateJson)
    match /conversations/{conversationId} {
      function isParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participantIds;
      }
      function isNewParticipant() {
        return isSignedIn() && request.auth.uid in request.resource.data.participantIds;
      }
      function isConversationAdmin() {
        return isSignedIn() && request.auth.uid in resource.data.adminIds;
      }
      function membershipUnchanged() {
        return request.resource.data.participantIds == resource.data.participantIds;
      }
      function isLeaving() {
        return !(request.auth.uid in request.resource.data.participantIds) &&
          request.resource.data.participantIds.size() ==
            resource.data.participantIds.size() - 1;
      }
      // Per-user fields (unread counters, pin/mute/archive/spam/accept/delete
      // state) are self-scoped: a participant may only touch the entry that
      // is their own uid, never another member's.
      function onlyTouchesOwnUserScopedFields() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let userScoped = [
          'pinnedBy', 'mutedBy', 'archivedBy', 'spamBy', 'acceptedBy',
          'deletedBy', 'unreadCounts'
        ];
        return changed.hasOnly(userScoped);
      }

      allow read: if isParticipant();
      allow create: if isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        isNewParticipant() &&
        isSameSchool(request.resource.data.schoolId);
      allow update: if isParticipant() && (
        membershipUnchanged() ||
        isConversationAdmin() ||
        isLeaving() ||
        onlyTouchesOwnUserScopedFields()
      );
      allow delete: if isConversationAdmin();

      match /messages/{messageId} {
        function conversation() {
          return get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data;
        }
        function isConversationParticipant() {
          return isSignedIn() && request.auth.uid in conversation().participantIds;
        }

        allow read: if isSignedIn() && request.auth.uid in resource.data.participantIds;
        allow create: if isSignedIn() &&
          request.resource.data.senderId == request.auth.uid &&
          isConversationParticipant() &&
          request.resource.data.participantIds == conversation().participantIds &&
          (conversation().get('messagePolicy', 'everyone') != 'adminsOnly' ||
           request.auth.uid in conversation().adminIds);
        // Covers: read receipts (readBy), reactions, stars, pin, edits by the
        // sender, and soft-delete (isDeleted) by the sender. Ownership of the
        // core content fields cannot change after creation.
        allow update: if isSignedIn() && isConversationParticipant() && (
          resource.data.senderId == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['readBy', 'reactions', 'starredBy', 'isPinned'])
        );
        allow delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
      }
    }

    // Backs the Search / Starred / Pinned collectionGroup('messages') queries
    // issued across all of a user's conversations at once.
    match /{path=**}/messages/{messageId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participantIds;
    }

    match /message_reports/{reportId} {
      allow read, update: if isStaff() && isSameSchool(resource.data.schoolId);
      allow create: if isSignedIn() &&
        request.resource.data.reportedBy == request.auth.uid &&
        isSameSchool(request.resource.data.schoolId) &&
        request.auth.uid in get(
          /databases/$(database)/documents/conversations/$(request.resource.data.conversationId)
        ).data.participantIds;
      allow delete: if false;
    }

    match /parent_access_codes/{code} {
      allow get: if true;
      allow list: if isStaff();
      allow write: if isStaff();
    }

    match /student_access_codes/{code} {
      // Pre-login students look themselves up by code before they have a
      // session, same as parent_access_codes. Admin can list/query by
      // studentId for the Portal Codes screen. All mutations (provision,
      // PIN reset, enable/disable) go exclusively through
      // provisionStudentAccessCode/resetStudentPin/setStudentAccessCodeStatus
      // (functions/student_credentials.js) so code entropy and PIN clearing
      // never trust the client - direct writes are denied here.
      allow get: if true;
      allow list: if isStaff() && isSameSchool(resource.data.schoolId);
      allow write: if false;
    }

    match /students/{studentId} {
      // isStaff() alone carries no tenant scope - without isSameSchool here,
      // any staff account (regardless of school) could read/write any
      // student document by id. Direct client writes are additionally
      // narrowed to updates only: creation goes through
      // createStudentWithCapacityCheck (functions/student_capacity.js),
      // which enforces the subscription seat cap the Admin SDK write path
      // would otherwise bypass.
      allow read: if (isStaff() && isSameSchool(resource.data.schoolId)) ||
        isParentOf(studentId) || isMe(studentId);
      allow update: if isStaff() && isSameSchool(resource.data.schoolId) &&
        isSameSchool(request.resource.data.schoolId);
      allow create, delete: if false;
    }

    function isStudentRecordReadable() {
      return isStaff() || isParentOf(resource.data.studentId) || isMe(resource.data.studentId);
    }

    match /academic_records/{docId} {
      allow read: if isStudentRecordReadable();
      allow write: if isStaff();
    }
    match /attendance_records/{docId} {
      allow read: if isStudentRecordReadable();
      allow write: if isStaff();
    }
    match /fees/{docId} {
      allow read: if isStudentRecordReadable();
      allow write: if isStaff();
    }
    match /payments/{docId} {
      allow read: if isStudentRecordReadable();
      allow create: if isStaff() || isParentOf(request.resource.data.studentId);
      allow update, delete: if isStaff();
    }
    match /health_visits/{docId} {
      allow read: if isStudentRecordReadable();
      allow write: if isStaff();
    }

    match /health_profiles/{docId} {
      allow read: if isSameSchool(resource.data.schoolId) && (
        canManageClinicalRecords() || isParentOf(resource.data.studentId) ||
        isMe(resource.data.studentId)
      );
      allow create: if canManageClinicalRecords() &&
        isSameSchool(request.resource.data.schoolId);
      allow update: if canManageClinicalRecords() &&
        isSameSchool(resource.data.schoolId) &&
        request.resource.data.schoolId == resource.data.schoolId &&
        request.resource.data.studentId == resource.data.studentId;
      allow delete: if false;
    }

    match /clinic_visits/{docId} {
      allow read: if isSameSchool(resource.data.schoolId) && (
        canManageClinicalRecords() || isParentOf(resource.data.studentId) ||
        isMe(resource.data.studentId)
      );
      allow create: if canManageClinicalRecords() &&
        isSameSchool(request.resource.data.schoolId) &&
        request.resource.data.recordedBy == request.auth.uid;
      allow update: if canManageClinicalRecords() &&
        isSameSchool(resource.data.schoolId) &&
        request.resource.data.schoolId == resource.data.schoolId &&
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.recordedBy == resource.data.recordedBy;
      allow delete: if false;
    }

    match /emergency_incidents/{docId} {
      allow read: if isSameSchool(resource.data.schoolId) && (
        canManageClinicalRecords() || isParentOf(resource.data.studentId) ||
        isMe(resource.data.studentId)
      );
      allow create: if canManageClinicalRecords() &&
        isSameSchool(request.resource.data.schoolId) &&
        request.resource.data.recordedBy == request.auth.uid;
      allow update: if canManageClinicalRecords() &&
        isSameSchool(resource.data.schoolId) &&
        request.resource.data.schoolId == resource.data.schoolId &&
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.recordedBy == resource.data.recordedBy;
      allow delete: if false;
    }

    match /medical_inventory/{docId} {
      allow read: if canManageMedicalSupplies() &&
        isSameSchool(resource.data.schoolId);
      allow create: if canManageMedicalSupplies() &&
        isSameSchool(request.resource.data.schoolId);
      allow update: if canManageMedicalSupplies() &&
        isSameSchool(resource.data.schoolId) &&
        request.resource.data.schoolId == resource.data.schoolId;
      allow delete: if hasAnyRole(['schoolAdmin', 'headTeacher']) &&
        isSameSchool(resource.data.schoolId);
    }

    match /medical_supply_requests/{docId} {
      allow read: if canManageMedicalSupplies() &&
        isSameSchool(resource.data.schoolId);
      allow create: if hasAnyRole(['nurse']) &&
        isSameSchool(request.resource.data.schoolId) &&
        request.resource.data.requestedBy == request.auth.uid &&
        request.resource.data.status == 'SupplyRequestStatus.pending';
      allow update: if hasAnyRole([
          'storeInventory', 'bursar', 'schoolAdmin', 'headTeacher', 'director'
        ]) &&
        isSameSchool(resource.data.schoolId) &&
        request.resource.data.schoolId == resource.data.schoolId &&
        request.resource.data.requestedBy == resource.data.requestedBy &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'bursaReviewNotes', 'rejectionReason', 'updatedAt'
        ]) && (
          (resource.data.status == 'SupplyRequestStatus.pending' &&
            request.resource.data.status in [
              'SupplyRequestStatus.approved', 'SupplyRequestStatus.rejected'
            ]) ||
          (resource.data.status == 'SupplyRequestStatus.approved' &&
            request.resource.data.status == 'SupplyRequestStatus.purchased') ||
          (resource.data.status == 'SupplyRequestStatus.purchased' &&
            request.resource.data.status == 'SupplyRequestStatus.delivered')
        );
      allow delete: if false;
    }

    match /welfare_records/{docId} {
      allow read: if isSameSchool(resource.data.schoolId) && (
        hasAnyRole(['boardingMatron', 'boardingPatron', 'schoolAdmin', 'headTeacher']) ||
        (resource.data.isPrivate == false && (
          hasAnyRole(['nurse']) || isParentOf(resource.data.studentId) ||
          isMe(resource.data.studentId)
        ))
      );
      allow create: if hasAnyRole(['boardingMatron', 'boardingPatron']) &&
        isSameSchool(request.resource.data.schoolId);
      allow update: if hasAnyRole(['boardingMatron', 'boardingPatron']) &&
        isSameSchool(resource.data.schoolId) &&
        request.resource.data.schoolId == resource.data.schoolId;
      allow delete: if false;
    }

    match /boarding_attendance/{docId} {
      allow read: if isStaff() || isParentOf(resource.data.studentId) || isMe(resource.data.studentId);
      allow write: if hasAnyRole(['boardingPatron', 'schoolAdmin', 'headTeacher', 'director']);
    }
    match /boarding_discipline/{docId} {
      allow read: if isStaff() || (
        resource.data.isPrivate == false &&
        (isParentOf(resource.data.studentId) || isMe(resource.data.studentId))
      );
      allow write: if hasAnyRole(['boardingPatron', 'schoolAdmin', 'headTeacher', 'director']);
    }
    match /boarding_announcements/{docId} {
      allow read: if isSignedIn();
      allow write: if hasAnyRole(['boardingPatron', 'schoolAdmin', 'headTeacher', 'director']);
    }
    match /boarding_leave_requests/{docId} {
      allow read: if isStaff() || isParentOf(resource.data.studentId) || isMe(resource.data.studentId);
      allow write: if hasAnyRole(['boardingPatron', 'schoolAdmin', 'headTeacher', 'director']);
    }
    match /bed_transfers/{docId} {
      allow read, write: if hasAnyRole(['boardingPatron', 'schoolAdmin', 'headTeacher', 'director']);
    }
    match /boarding_counseling_referrals/{docId} {
      allow read, write: if hasAnyRole(['boardingPatron', 'schoolAdmin', 'headTeacher', 'director']);
    }
    match /boarding_behaviour_observations/{docId} {
      allow read, write: if hasAnyRole(['boardingPatron', 'schoolAdmin', 'headTeacher', 'director']);
    }

    match /library_books/{docId} {
      allow read: if isStudentRecordReadable();
      allow write: if isStaff();
    }
    match /discipline_incidents/{docId} {
      allow read: if isStudentRecordReadable();
      allow write: if isStaff();
    }
    match /transport/{docId} {
      allow read: if isStudentRecordReadable();
      allow write: if isStaff();
    }

    match /attendance/{docId} {
      allow read: if isStaff() || isParentOf(resource.data.studentId) || isMe(resource.data.studentId);
      allow write: if isStaff();
      // Legacy/unused nested path - no current reader/writer found in
      // functions/ or lib/ (all real student writes go through the
      // top-level /students/{studentId} match above). Tenant-scoped to
      // match it rather than left wide open.
      match /students/{studentId} {
        allow read, write: if isStaff() &&
          isSameSchool(get(/databases/$(database)/documents/students/$(studentId)).data.schoolId);
      }
    }

    match /attendance_logs/{docId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /school_stats/{docId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /users/{uid}/tokens/{tokenId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    match /alerts/{alertId} {
      allow read: if isStaff() ||
        (resource.data.studentId != null && (isParentOf(resource.data.studentId) || isMe(resource.data.studentId))) ||
        (resource.data.userId != null && isSignedIn() && resource.data.userId == request.auth.uid) ||
        (resource.data.targets is list && isParent() && resource.data.targets.hasAny(myUser().groups));
      allow create: if isStaff() ||
        (isParent() &&
         request.resource.data.userId is string &&
         request.resource.data.userId != request.auth.uid &&
         !('targets' in request.resource.data) &&
         !('studentId' in request.resource.data));
      allow update: if isStaff() ||
        (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']));
      allow delete: if isStaff();
    }

    match /visitors/{id} {
      allow read, update, delete: if isStaff() && isSameSchool(resource.data.schoolId);
      allow create: if isStaff() && isSameSchool(request.resource.data.schoolId);
    }
    match /appointments/{id} {
      allow read, write: if isStaff();
    }

    match /appointment_types/{id} {
      allow read: if isSignedIn();
      allow create: if isStaff() && isSameSchool(request.resource.data.schoolId);
      allow update, delete: if isStaff() && isSameSchool(resource.data.schoolId);
    }
    match /staff_availability/{staffId} {
      allow read: if isSignedIn();
      allow write: if isStaff() && (
        request.auth.uid == staffId ||
        myRole() in ['schoolAdmin', 'director', 'headTeacher', 'deputyHead']
      );
    }
    match /meeting_appointments/{id} {
      allow read: if isStaff() || (isParent() && resource.data.requesterId == request.auth.uid);
      allow create: if isSignedIn() &&
        isSameSchool(request.resource.data.schoolId) &&
        request.resource.data.requesterId == request.auth.uid;
      allow update: if (isStaff() && isSameSchool(resource.data.schoolId)) || (
        isParent() && resource.data.requesterId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'respondedBy', 'responseNote'])
      );
      allow delete: if false;
      match /private_notes/{noteId} {
        allow read, write: if isStaff();
      }
    }

    match /schools/{schoolId}/assessmentTypes/{id} {
      allow read: if isSameSchool(schoolId);
      allow write: if isStaff() && isSameSchool(schoolId);
    }
    match /schools/{schoolId}/gradingSystems/{id} {
      allow read: if isSameSchool(schoolId);
      allow write: if isStaff() && isSameSchool(schoolId);
    }
    match /schools/{schoolId}/assessmentMarks/{id} {
      allow read, write: if isStaff() && isSameSchool(schoolId);
      match /auditLog/{entryId} {
        allow read: if isStaff() && isSameSchool(schoolId);
        allow create: if isStaff() && isSameSchool(schoolId);
        allow update, delete: if false;
      }
    }
    match /schools/{schoolId}/reportCards/{id} {
      allow read: if (isStaff() && isSameSchool(schoolId)) ||
        isParentOf(resource.data.studentId) || isMe(resource.data.studentId);
      allow write: if isStaff() && isSameSchool(schoolId);
      match /auditLog/{entryId} {
        allow read: if isStaff() && isSameSchool(schoolId);
        allow create: if isStaff() && isSameSchool(schoolId);
        allow update, delete: if false;
      }
    }
    match /schools/{schoolId}/reportTemplates/{id} {
      allow read: if isSameSchool(schoolId);
      allow write: if isStaff() && isSameSchool(schoolId);
    }
    match /schools/{schoolId}/commentBank/{id} {
      allow read, write: if isStaff() && isSameSchool(schoolId);
    }
    match /schools/{schoolId}/configs/reportReleasePolicy {
      allow read: if isSameSchool(schoolId);
      allow write: if isStaff() && isSameSchool(schoolId);
    }
    match /schools/{schoolId}/reportVerifications/{code} {
      allow get: if true;
      allow list: if false;
      allow write: if isStaff() && isSameSchool(schoolId);
    }

    match /schools/{schoolId}/gates/{id} {
      allow read: if isSameSchool(schoolId);
      allow write: if isSameSchool(schoolId) &&
        hasAnyRole(['securityHead', 'gatekeeper', 'schoolAdmin', 'director', 'headTeacher']);
    }
    match /schools/{schoolId}/student_movements/{id} {
      allow read: if (isStaff() && isSameSchool(schoolId)) ||
        isParentOf(resource.data.studentId) || isMe(resource.data.studentId);
      allow create: if isStaff() && isSameSchool(schoolId);
      allow update, delete: if false;
    }
    match /schools/{schoolId}/staff_movements/{id} {
      allow read, create: if isStaff() && isSameSchool(schoolId);
      allow update, delete: if false;
    }
    match /schools/{schoolId}/security_incidents/{id} {
      allow read, write: if isStaff() && isSameSchool(schoolId);
    }
    match /schools/{schoolId}/emergency_events/{id} {
      allow read, write: if isStaff() && isSameSchool(schoolId);
    }
    match /schools/{schoolId}/security_patrols/{id} {
      allow read, write: if isStaff() && isSameSchool(schoolId);
    }
    match /schools/{schoolId}/lost_and_found/{id} {
      allow read, write: if isStaff() && isSameSchool(schoolId);
    }
    match /schools/{schoolId}/pickup_authorizations/{id} {
      allow read: if (isStaff() && isSameSchool(schoolId)) || isParentOf(resource.data.studentId);
      allow write: if isStaff() && isSameSchool(schoolId);
    }
    match /{path=**}/pickup_authorizations/{id} {
      allow read: if (isStaff() && isSameSchool(resource.data.schoolId)) || isParentOf(resource.data.studentId);
    }
    match /schools/{schoolId}/configs/securitySettings {
      allow read: if isSameSchool(schoolId);
      allow write: if isSameSchool(schoolId) &&
        hasAnyRole(['securityHead', 'schoolAdmin', 'director', 'headTeacher']);
    }
    match /schools/{schoolId}/credentials/{id} {
      allow read, write: if isStaff() && isSameSchool(schoolId);
    }
    match /schools/{schoolId}/revoked_credentials/{id} {
      allow read, write: if isStaff() && isSameSchool(schoolId);
    }
    match /schools/{schoolId}/verification_events/{id} {
      allow read: if isStaff() && isSameSchool(schoolId);
      allow create: if isStaff() && isSameSchool(schoolId);
      allow update, delete: if false;
    }

    match /visitor_blacklist/{id} {
      allow read, update, delete: if isStaff() && isSameSchool(resource.data.schoolId);
      allow create: if isStaff() && isSameSchool(request.resource.data.schoolId);
    }
    match /pre_approved_visitors/{id} {
      allow read, update, delete: if isStaff() && isSameSchool(resource.data.schoolId);
      allow create: if isStaff() && isSameSchool(request.resource.data.schoolId);
    }
    match /scheduled_visits/{id} {
      allow read, update, delete: if isStaff() && isSameSchool(resource.data.schoolId);
      allow create: if isStaff() && isSameSchool(request.resource.data.schoolId);
    }
    match /package_deliveries/{id} {
      allow read, update, delete: if isStaff() && isSameSchool(resource.data.schoolId);
      allow create: if isStaff() && isSameSchool(request.resource.data.schoolId);
    }

    match /audit_logs/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    match /config/{configId} {
      allow read, write: if isStaff();
      match /history/{historyId} {
        allow read, create: if isStaff();
        allow update, delete: if false;
      }
    }
    match /config/appointment_policy {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    // School structure management.
    match /educational_levels/{id} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }
    match /academic_years/{id} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }
    match /academic_terms/{id} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }
    match /classes/{id} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }
    match /class_streams/{id} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }
    match /subjects/{id} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }
    match /departments/{id} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }
    match /staff_designations/{id} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }
    match /staff_roles/{id} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }
    match /structure_config/{id} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    // Sequential Structure runtime data. Every document carries schoolId;
    // unlike the legacy master-data collections above, these new records are
    // tenant-isolated in rules as well as in repository queries.
    match /structure_setup_preferences/{schoolId} {
  allow read, delete: if isStaff() && isSameSchool(schoolId);
  allow create: if isStaff() &&
    request.resource.data.schoolId == schoolId && isSameSchool(schoolId);
  allow update: if isStaff() && isSameSchool(schoolId) &&
    request.resource.data.schoolId == schoolId;
}
match /structure_curriculum_assignments/{id} {
  allow read, delete: if isStaff() && isSameSchool(resource.data.schoolId);
  allow create: if isStaff() && isSameSchool(request.resource.data.schoolId);
  allow update: if isStaff() && isSameSchool(resource.data.schoolId) &&
    request.resource.data.schoolId == resource.data.schoolId;
}
match /structure_teaching_assignments/{id} {
  allow read, delete: if isStaff() && isSameSchool(resource.data.schoolId);
  allow create: if isStaff() && isSameSchool(request.resource.data.schoolId);
  allow update: if isStaff() && isSameSchool(resource.data.schoolId) &&
    request.resource.data.schoolId == resource.data.schoolId;
}
match /structure_class_timetables/{id} {
  allow read, delete: if isStaff() && isSameSchool(resource.data.schoolId);
  allow create: if isStaff() && isSameSchool(request.resource.data.schoolId);
  allow update: if isStaff() && isSameSchool(resource.data.schoolId) &&
    request.resource.data.schoolId == resource.data.schoolId;
}
match /structure_timetable_lessons/{id} {
  allow read, delete: if isStaff() && isSameSchool(resource.data.schoolId);
  allow create: if isStaff() && isSameSchool(request.resource.data.schoolId);
  allow update: if isStaff() && isSameSchool(resource.data.schoolId) &&
    request.resource.data.schoolId == resource.data.schoolId;
}

    match /houses/{id} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }
    match /clubs/{id} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }
