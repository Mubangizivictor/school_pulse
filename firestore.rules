      allow write: if isStaff();
    }
    match /custom_fields/{id} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /staff_attendance/{id} {
      allow read, write: if isStaff();
    }
    match /stats/{docId} {
      allow read, write: if isStaff();
    }
    match /bus_routes/{id} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }
    match /trips/{id} {
      allow read, write: if isStaff();
    }
    match /dormitories/{id} {
      allow read: if isSignedIn();
      allow write: if isStaff();
      match /beds/{bedId} {
        allow read, write: if hasAnyRole(['boardingPatron', 'boardingMatron', 'schoolAdmin', 'headTeacher', 'director']);
      }
    }
    match /meal_plans/{id} {
      allow read, write: if isStaff();
    }
    match /sports_fixtures/{id} {
      allow read, write: if isStaff();
    }
    match /exams/{id} {
      allow read, write: if isStaff();
    }
    match /counseling_sessions/{id} {
      allow read, write: if isStaff();
    }
    match /homework/{id} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }
