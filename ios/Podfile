platform :ios, '15.5'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# Only the Google ML Kit / mobile_scanner dependency chain ships no arm64
# slice for the iOS Simulator. Every other pod (isar_flutter_libs included -
# its xcframework is a genuine arm64+x86_64 fat binary) links fine natively
# on an Apple Silicon simulator. Scoping the exclusion to just these targets
# avoids forcing unrelated pods like isar down the x86_64/Rosetta path,
# which broke `Library 'isar' not found` link errors on iPhone 16/17
# Pro Max simulators.
ARM64_SIMULATOR_EXCLUDED_TARGETS = %w[
  GoogleMLKit
  MLKitBarcodeScanning
  MLKitCommon
  MLKitVision
  MLImage
  GoogleToolboxForMac
  GoogleDataTransport
  GoogleUtilities
  GTMSessionFetcher
  nanopb
  PromisesObjC
  mobile_scanner
].freeze

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    next unless ARM64_SIMULATOR_EXCLUDED_TARGETS.any? { |name| target.name.start_with?(name) }

    target.build_configurations.each do |config|
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
    end
  end

  # The Google ML Kit / mobile_scanner chain ships no arm64 simulator slice,
  # so those pod targets are forced to EXCLUDED_ARCHS=arm64 above (i.e. they
  # only build x86_64 on the simulator SDK). Runner.xcodeproj itself has no
  # arch override of its own, so on an Apple Silicon host it defaults to
  # building arm64-native for the simulator — a hard mismatch against the
  # x86_64-only mobile_scanner/GoogleMLKit modules it imports
  # (GeneratedPluginRegistrant.m -> "Module 'mobile_scanner' not found").
  # isar_flutter_libs supports both arm64 and x86_64 simulator slices in one
  # fat archive, so it is not the constraint — the MLKit chain is. Force
  # Runner (and RunnerTests) to the same x86_64-only simulator arch as the
  # MLKit chain so every target in the workspace agrees on one arch.
  installer.aggregate_targets.each do |aggregate_target|
    aggregate_target.user_project.native_targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
      end
    end
    aggregate_target.user_project.save
  end
end
