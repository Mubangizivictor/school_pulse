<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>School Pulse</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>school_pulse</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>NFCReaderUsageDescription</key>
		<string>School Pulse uses NFC to read student ID cards for attendance and identity verification.</string>
		<!-- QA-only: allows plain-HTTP calls to the local Firebase Cloud
		     Functions emulator (http://localhost:5001) from a debug build
		     run with --dart-define=USE_FIREBASE_EMULATOR=true. Without this,
		     iOS's default App Transport Security policy silently blocks the
		     Functions SDK's plain-HTTP request to the emulator, which the
		     SDK then surfaces as a generic "not-found" error indistinguishable
		     from a real missing-callable error. Scoped to localhost only -
		     does not weaken ATS for any other host or for release builds. -->
		<key>NSAppTransportSecurity</key>
		<dict>
			<key>NSAllowsLocalNetworking</key>
			<true/>
			<key>NSExceptionDomains</key>
			<dict>
				<key>localhost</key>
				<dict>
					<key>NSExceptionAllowsInsecureHTTPLoads</key>
					<true/>
				</dict>
				<key>127.0.0.1</key>
				<dict>
					<key>NSExceptionAllowsInsecureHTTPLoads</key>
					<true/>
				</dict>
			</dict>
		</dict>
		<key>NSBluetoothAlwaysUsageDescription</key>
		<string>School Pulse uses Bluetooth to connect to badge and ID card printers.</string>
		<key>NSBluetoothPeripheralUsageDescription</key>
		<string>School Pulse uses Bluetooth to connect to badge and ID card printers.</string>
		<key>NSCameraUsageDescription</key>
		<string>School Pulse uses the camera to capture visitor and ID photos and to scan QR codes for attendance.</string>
		<key>NSFaceIDUsageDescription</key>
		<string>School Pulse uses Face ID to protect access to the owner console with biometric app lock.</string>
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>School Pulse uses your location only when you choose to share it in a chat.</string>
		<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
		<string>School Pulse uses your location only when you choose to share it in a chat.</string>
		<key>NSMicrophoneUsageDescription</key>
		<string>School Pulse uses the microphone to record voice notes in chats.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>School Pulse needs access to your photo library to attach images such as visitor photos and documents.</string>
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>com.googleusercontent.apps.925585407650-i7ue01rvhgud5056aur2emdel8ll70kp</string>
				</array>
			</dict>
		</array>
		<key>UIApplicationSceneManifest</key>
		<dict>
			<key>UIApplicationSupportsMultipleScenes</key>
			<false/>
			<key>UISceneConfigurations</key>
			<dict>
				<key>UIWindowSceneSessionRoleApplication</key>
				<array>
					<dict>
						<key>UISceneClassName</key>
						<string>UIWindowScene</string>
						<key>UISceneConfigurationName</key>
						<string>flutter</string>
						<key>UISceneDelegateClassName</key>
						<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
						<key>UISceneStoryboardFile</key>
						<string>Main</string>
					</dict>
				</array>
			</dict>
		</dict>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UIBackgroundModes</key>
		<array>
			<string>fetch</string>
			<string>remote-notification</string>
		</array>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UIStatusBarHidden</key>
		<false/>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
	</dict>
</plist>
