{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "school-pulse-3d95b",
          "appId": "1:925585407650:android:671a08de8f49ea1d9461fb",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "school-pulse-3d95b",
          "appId": "1:925585407650:ios:7fd13d46681d5a449461fb",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "school-pulse-3d95b",
          "configurations": {
            "android": "1:925585407650:android:671a08de8f49ea1d9461fb",
            "ios": "1:925585407650:ios:7fd13d46681d5a449461fb",
            "web": "1:925585407650:web:73c0b063dc0398cf9461fb"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules",
    "bucket": "school-pulse-3d95b.firebasestorage.app"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/verify",
        "function": {
          "functionId": "verifyOfficialDocument",
          "region": "europe-west1"
        }
      },
      {
        "source": "/verify-student",
        "function": {
          "functionId": "verifyStudentQrCredential",
          "region": "europe-west1"
        }
      },
      {
        "source": "/verify-report",
        "function": {
          "functionId": "verifyReportCard",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log"]
    },
    {
      "source": "public_functions",
      "codebase": "publicwebsite",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log"]
    }
  ],
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "auth": {
      "port": 9099
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": false
    }
  }
}
