{
  "name": "School Pulse",
  "version": "1.0.0",
  "note": "Single source of truth for the brand. The Flutter theme and the website CSS variables are both generated from this file. Change a value here, regenerate, and both update.",
  "fonts": {
    "display": "Plus Jakarta Sans",
    "body": "Inter",
    "mono": "JetBrains Mono",
    "weights": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "extrabold": 800 }
  },
  "typeScale": {
    "display": { "size": 40, "lineHeight": 48, "weight": 800, "font": "display", "letterSpacing": -0.8 },
    "h1": { "size": 32, "lineHeight": 40, "weight": 800, "font": "display", "letterSpacing": -0.6 },
    "h2": { "size": 24, "lineHeight": 32, "weight": 700, "font": "display", "letterSpacing": -0.3 },
    "h3": { "size": 20, "lineHeight": 28, "weight": 700, "font": "display", "letterSpacing": -0.2 },
    "title": { "size": 16, "lineHeight": 24, "weight": 600, "font": "body", "letterSpacing": 0 },
    "body": { "size": 15, "lineHeight": 22, "weight": 400, "font": "body", "letterSpacing": 0 },
    "bodySmall": { "size": 13, "lineHeight": 20, "weight": 400, "font": "body", "letterSpacing": 0 },
    "label": { "size": 12, "lineHeight": 16, "weight": 600, "font": "body", "letterSpacing": 0.6 },
    "numeric": { "note": "Use tabular figures for money, marks and attendance", "fontFeatures": ["tnum"] }
  },
  "brand": { "navy": "#0E1B3D", "royal": "#1F4FD1", "gold": "#D4A017" },
  "light": {
    "primary": "#1F4FD1", "onPrimary": "#FFFFFF", "primaryHover": "#1A42B0", "primarySoft": "#E8EEFC", "onPrimarySoft": "#163A9C",
    "secondary": "#0E1B3D", "onSecondary": "#FFFFFF",
    "accent": "#D4A017", "onAccent": "#0E1B3D", "accentSoft": "#FBF3DC", "onAccentSoft": "#7A5A06",
    "background": "#F6F6F2", "surface": "#FFFFFF", "surfaceAlt": "#EFEFEA",
    "border": "#DCDCD4", "borderStrong": "#C3C3BA",
    "text": "#141B2D", "textMuted": "#535B6C", "textSubtle": "#656C7C", "textOnDark": "#FFFFFF",
    "success": "#13703A", "successSoft": "#E6F4EA",
    "warning": "#A14A07", "warningSoft": "#FDF0E1",
    "error": "#B42318", "onError": "#FFFFFF", "errorSoft": "#FCE9E7",
    "info": "#1F4FD1", "infoSoft": "#E8EEFC",
    "focusRing": "#1F4FD1", "shadow": "rgba(14, 27, 61, 0.08)"
  },
  "dark": {
    "primary": "#7A9BFF", "onPrimary": "#0A1330", "primaryHover": "#94AFFF", "primarySoft": "#1B2A55", "onPrimarySoft": "#C6D4FF",
    "secondary": "#E9EDF7", "onSecondary": "#0E1B3D",
    "accent": "#E5B536", "onAccent": "#0E1B3D", "accentSoft": "#3A2F12", "onAccentSoft": "#F3D98A",
    "background": "#0A0F1F", "surface": "#111933", "surfaceAlt": "#18223F",
    "border": "#27324F", "borderStrong": "#3A4668",
    "text": "#EDF0F7", "textMuted": "#A6AEC2", "textSubtle": "#8790A6", "textOnDark": "#FFFFFF",
    "success": "#4ADE80", "successSoft": "#123222",
    "warning": "#FBBF24", "warningSoft": "#3A2A0B",
    "error": "#F87171", "onError": "#0A1330", "errorSoft": "#3D1517",
    "info": "#7A9BFF", "infoSoft": "#1B2A55",
    "focusRing": "#7A9BFF", "shadow": "rgba(0, 0, 0, 0.40)"
  },
  "radius": { "sm": 6, "md": 10, "lg": 14, "xl": 20, "pill": 999, "appIcon": "24%" },
  "spacing": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "2xl": 32, "3xl": 48, "4xl": 64 },
  "logo": {
    "mark": "Roof beat: one heartbeat line whose peak is a school roof, gold dot (the bell) above",
    "lightBackground": { "line": "#1F4FD1", "dot": "#D4A017", "wordmark": "#0E1B3D" },
    "darkBackground": { "line": "#FFFFFF", "dot": "#D4A017", "wordmark": "#FFFFFF" },
    "appIcon": { "light": { "tile": "#1F4FD1", "line": "#FFFFFF", "dot": "#D4A017" }, "dark": { "tile": "#0E1B3D", "line": "#FFFFFF", "dot": "#D4A017" } },
    "svgPath": "M12 62 H27 L33 70 L50 33 L67 62 H88", "dot": { "cx": 50, "cy": 19, "r": 6.5 }, "viewBox": "0 0 100 100"
  }
}
